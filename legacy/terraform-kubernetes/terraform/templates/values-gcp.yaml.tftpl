global:
  projectId: ${project_id}
  region: ${region}
  namespace: ${namespace}
  bucketName: ${gcs_bucket_name}
  existingSecret: ${runtime_secret_name}

  marketplace:
    consumptionLabel: "${marketplace_consumption_label}"
    serviceName: "${marketplace_service_name}"
    serviceLevel: "${marketplace_service_level}"

  ingress:
    enabled: true
    staticIpName: ${static_ip_name}
    allowHttp: ${allow_http}
    frontendConfigName: ${frontend_config_name}

    hosts:
      auth: auth.${domain_suffix}
      apiAuth: api-auth.${domain_suffix}
      app: app.${domain_suffix}
      apiAsmPlus: api-asm-plus.${domain_suffix}
      apiSap: api-sap.${domain_suffix}
      apiSf: api-sf.${domain_suffix}
      viewer: viewer.${domain_suffix}

    tls:
      enabled: true
      managedCertificateName: ${managed_certificate_name}

  cloudSql:
    enabled: true
    instanceConnectionName: ${project_id}:${region}:${cloudsql_instance_name}
    privateIp: true

    serviceAccount:
      name: ${cloudsql_ksa_name}
      gsaEmail: ${cloudsql_gsa_name}@${project_id}.iam.gserviceaccount.com

    proxy:
      repository: ${cloud_sql_proxy_image_repo}
      tag: "${cloud_sql_proxy_image_tag}"
      port: 5432

      resources:
        requests:
          cpu: 25m
          memory: 64Mi
        limits:
          cpu: 250m
          memory: 256Mi

postgresql:
  enabled: false
  image:
    repository: ${postgres_image_repo}
    tag: "${postgres_image_tag}"
    pullPolicy: IfNotPresent
  database: ${cloudsql_database}
  username: ${cloudsql_user}
  port: 5432
  storageSize: 10Gi

asm-api:
  enabled: true
  replicaCount: 1
  image:
    repository: ${image_repositories["api-asm"]}
    tag: '${image_tags["api-asm"]}'
    pullPolicy: IfNotPresent
  port: 3000
  serviceAccountName: ${asm_ksa_name}

  serviceAccountAnnotations:
    iam.gke.io/gcp-service-account: ${asm_gsa_name}@${project_id}.iam.gserviceaccount.com
  resources:
    requests:
      cpu: 50m
      memory: 128Mi
    limits:
      cpu: 500m
      memory: 1Gi
  config:
    NODE_ENV: production
    HOST: 0.0.0.0
    PORT: "3000"
    CORS_ALLOWED_ORIGINS: "https://app.${domain_suffix},https://viewer.${domain_suffix}"
    ASM_SERVER_VENDOR_ID: "ASM by Auritas"
    ASM_RAW_BODY_LIMIT: "262144000"

    BTP_HYPERSCALER: GCP
    STORAGE_PROVIDER: gcs
    GCS_BUCKET: ${gcs_bucket_name}
    GOOGLE_CLOUD_PROJECT: ${project_id}

auth-api:
  enabled: true
  replicaCount: 1
  image:
    repository: ${image_repositories["api-auth"]}
    tag: '${image_tags["api-auth"]}'
    pullPolicy: IfNotPresent
  port: 3000
  resources:
    requests:
      cpu: 50m
      memory: 128Mi
    limits:
      cpu: 500m
      memory: 1Gi
  config:
    NODE_ENV: production
    SERVICE_NAME: auritas-auth-api
    HOST: 0.0.0.0
    PORT: "3000"
    API_BASE_PATH: /api
    PUBLIC_BASE_URL: "https://api-auth.${domain_suffix}"
    HEALTHCHECK_PATH: /health
    DOCS_ENABLED: "true"

    CORS_ALLOWED_ORIGINS: "https://auth.${domain_suffix},https://app.${domain_suffix},https://api-asm-plus.${domain_suffix},https://viewer.${domain_suffix}"

    PGHOST: "127.0.0.1"
    PGPORT: "5432"
    PGUSER: ${cloudsql_user}
    PGDATABASE: ${cloudsql_database}
    DATABASE_SSL_MODE: disable

    DB_POOL_MAX: "10"
    DB_IDLE_TIMEOUT_MS: "30000"
    DB_CONNECTION_TIMEOUT_MS: "10000"

    JWT_EXPIRES_IN: 8h

    AUTH_SUPER_ADMIN_EMAIL: "${admin_email}"
    AUTH_SUPER_ADMIN_USERNAME: admin
    AUTH_SUPER_ADMIN_FIRST_NAME: ASM
    AUTH_SUPER_ADMIN_LAST_NAME: Administrator


asm-plus-api:
  enabled: true
  replicaCount: 1
  image:
    repository: ${image_repositories["api-asm-plus"]}
    tag: '${image_tags["api-asm-plus"]}'
    pullPolicy: IfNotPresent
  port: 3000
  resources:
    requests:
      cpu: 100m
      memory: 256Mi
    limits:
      cpu: 500m
      memory: 1Gi
  config:
    NODE_ENV: production
    HOST: 0.0.0.0
    PORT: "3000"

    BASE_URL: "https://api-asm-plus.${domain_suffix}"
    CORS_ORIGINS: "https://app.${domain_suffix},https://viewer.${domain_suffix},https://auth.${domain_suffix}"

    JSON_BODY_LIMIT: 1mb
    RAW_BODY_LIMIT: 250mb
    KEEP_ALIVE_TIMEOUT_MS: "65000"
    HEADERS_TIMEOUT_MS: "66000"
    REQUEST_TIMEOUT_MS: "120000"
    SHUTDOWN_TIMEOUT_MS: "30000"

    PGHOST: "127.0.0.1"
    PGPORT: "5432"
    PGUSER: ${cloudsql_user}
    PGDATABASE: ${cloudsql_database}
    PGSSLMODE: disable

    DB_POOL_MAX: "10"
    DB_POOL_CONNECTION_TIMEOUT_MS: "10000"
    DB_QUERY_TIMEOUT_MS: "30000"
    DB_STATEMENT_TIMEOUT_MS: "30000"
    DB_LOCK_TIMEOUT_MS: "10000"
    DB_IDLE_IN_TRANSACTION_SESSION_TIMEOUT_MS: "30000"

    JWT_EXPIRES_IN: 8h

    ASM_MICROSERVICE_URL: "http://asm-api:3000"
    ASM_CONT_REP: DMS
    ASM_SERVER_VENDOR_ID: "ASM by Auritas"

    SAP_FILE_WRITE_CONCURRENCY: "4"
    SAP_FILE_WRITE_RETRY_AFTER_SECONDS: "10"

api-sap:
  enabled: true
  replicaCount: 1
  image:
    repository: ${image_repositories["api-sap"]}
    tag: '${image_tags["api-sap"]}'
    pullPolicy: IfNotPresent
  port: 3020
  service:
    type: ClusterIP
  resources:
    requests:
      cpu: 50m
      memory: 128Mi
    limits:
      cpu: 500m
      memory: 1Gi
  config:
    NODE_ENV: production
    HOST: 0.0.0.0
    PORT: "3020"
    ASM_MICROSERVICE_URL: "http://asm-api:3000"
    ASM_VIEWER_URL: "https://viewer.${domain_suffix}"
    PUBLIC_BASE_URL: "https://api-sap.${domain_suffix}"
    CORS_ALLOWED_ORIGINS: "https://app.${domain_suffix},https://viewer.${domain_suffix},https://api-sap.${domain_suffix}"
    ASM_SERVER_VENDOR_ID: "ASM by Auritas"
    ASM_RAW_BODY_LIMIT: "262144000"
    PGHOST: "127.0.0.1"
    PGPORT: "5432"
    PGUSER: ${cloudsql_user}
    PGDATABASE: ${cloudsql_database}
    PGSSLMODE: disable
    VECTOR_API_URL: ""

api-sf:
  enabled: true
  replicaCount: 1
  image:
    repository: ${image_repositories["api-sf"]}
    tag: '${image_tags["api-sf"]}'
    pullPolicy: IfNotPresent
  port: 3030
  service:
    type: ClusterIP
  resources:
    requests:
      cpu: 50m
      memory: 128Mi
    limits:
      cpu: 500m
      memory: 1Gi
  config:
    NODE_ENV: production
    HOST: 0.0.0.0
    PORT: "3030"
    ASM_MICROSERVICE_URL: "http://asm-api:3000"
    PUBLIC_BASE_URL: "https://api-sf.${domain_suffix}"
    SF_DEFAULT_REPOSITORY: SF
    SF_REPOSITORIES: SF
    SF_METADATA_COMP_ID: metadata
    SF_CONTENT_COMP_ID: data
    SF_RAW_BODY_LIMIT: 250mb
    SF_TOKEN_ISSUER: auritas-sf
    SF_TOKEN_TTL_SECONDS: "86400"
    PGHOST: "127.0.0.1"
    PGPORT: "5432"
    PGUSER: ${cloudsql_user}
    PGDATABASE: ${cloudsql_database}
    PGSSLMODE: disable
    VECTOR_API_URL: ""

front-auth:
  enabled: true
  replicaCount: 1
  image:
    repository: ${image_repositories["front-auth"]}
    tag: '${image_tags["front-auth"]}'
    pullPolicy: IfNotPresent
  port: 80
  resources:
    requests:
      cpu: 50m
      memory: 128Mi
    limits:
      cpu: 250m
      memory: 512Mi
  config:
    APP_NAME: "ASM+ Authentication Portal"
    API_BASE_URL: "https://api-auth.${domain_suffix}"
    ROUTER_BASENAME: /
    NGINX_PORT: "80"

front-asm-plus:
  enabled: true
  replicaCount: 1
  image:
    repository: ${image_repositories["front-asm-plus"]}
    tag: '${image_tags["front-asm-plus"]}'
    pullPolicy: IfNotPresent
  port: 8080
  resources:
    requests:
      cpu: 50m
      memory: 128Mi
    limits:
      cpu: 250m
      memory: 512Mi
  config:
    PORT: "8080"
    APP_NAME: ASM+
    DOCUMENT_TITLE: ASM+
    ROUTER_BASENAME: /

    API_BASE_URL: "https://api-asm-plus.${domain_suffix}"
    BASE_AUTH_API: "https://api-auth.${domain_suffix}"
    FILE_VIEWER_BASE_URL: "https://viewer.${domain_suffix}"
    SSO_URL: "https://auth.${domain_suffix}/sso?redirect={redirect}"

    ROOT_LABEL: Documents
    FOLDERS_LABEL: Folders
    RESTORE_ROOT_FOLDER_ID: root

    AI_NAV_URL: ""
    CMIS_BASE_URL: ""
    DATA_VIEWER_URL: ""
    SAP_DEFAULT_AUTH_ID: ""
    SAP_DEFAULT_CONTENT_REPOSITORY: ""

front-viewer:
  enabled: true
  replicaCount: 1
  image:
    repository: ${image_repositories["front-viewer"]}
    tag: '${image_tags["front-viewer"]}'
    pullPolicy: IfNotPresent
  port: 8080
  resources:
    requests:
      cpu: 50m
      memory: 128Mi
    limits:
      cpu: 250m
      memory: 512Mi
  config:
    PORT: "8080"
    APP_NAME: "ASM+ Viewer"
    APP_TITLE: "ASM+ Document Viewer"
    ROUTER_BASENAME: /

    API_BASE_URL_PLUS: "https://api-asm-plus.${domain_suffix}/api/file"
    BASE_AUTH_API: "https://api-auth.${domain_suffix}"
    SSO_URL: "https://auth.${domain_suffix}/sso?redirect={redirect}"
    SSO_MODE: redirect

    AUTH_APPLICATION_NAME: "ASM+ Viewer"
    AUTH_APP_ID: "${viewer_auth_app_id}"
    AUTH_CLIENT_KEY: ""
    API_BASE_URL_SAP: "https://api-sap.${domain_suffix}/api/sap"
    API_BASE_URL_VECTOR: ""

    ONLYOFFICE_SERVER_URL: ""
    ONLYOFFICE_CALLBACK_BASE: ""
    ONLYOFFICE_DOCUMENT_PROXY_BASE: ""

    REDACTION_API_URL: ""

migrations:
  auth:
    enabled: false

  asmPlus:
    enabled: false
