# Copy this file to a protected local file outside source control and replace
# the example values. Do not commit credentials or customer-specific values.

project_id    = "your-customer-project"
region        = "us-east1"
zone          = "us-east1-b"
domain_suffix = "asmplus.example.com"
admin_email   = "asmplus-admin@example.com"

node_machine_type = "e2-standard-4"
min_nodes            = 1
max_nodes            = 4

cloudsql_tier              = "db-custom-2-7680"
cloudsql_availability_type = "ZONAL"
cloudsql_disk_size_gb      = 20

manage_dns_records   = false
dns_managed_zone_name = null

# Enable either integration workload independently when required.
enable_sap_business_api   = false
enable_successfactors_api = false

# These inputs are retained in Terraform state when populated. Leave the safe
# defaults here and configure approved connector credentials through Secret
# Manager after deployment whenever possible.
sap_basic_auth_users_json = "{}"
sf_managed_users_json     = "{}"
